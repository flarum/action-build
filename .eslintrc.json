{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "extends": ["eslint:recommended", "plugin:@typescript-eslint/recommended"],
  "env": {
    "node": true,
    "es2022": true
  },
  "ignorePatterns": ["dist/", "lib/", "node_modules/", "*.test.ts"],
  "rules": {
    "no-console": "warn",
    "eqeqeq": ["error", "smart"],
    "no-var": "error",
    "prefer-const": "error"
  }
}
